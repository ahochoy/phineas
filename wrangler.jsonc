{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phineas-finance",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "DEMO_ENABLED": "true" },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "71001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SESSION_LIMIT", "namespace_id": "71002", "simple": { "limit": 3, "period": 60 } },
    { "name": "QUESTION_LIMIT", "namespace_id": "71003", "simple": { "limit": 12, "period": 60 } },
    { "name": "UNLOCK_LIMIT", "namespace_id": "71004", "simple": { "limit": 5, "period": 60 } }
  ]
}
